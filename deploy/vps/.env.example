# Copy to .env (gitignored) and fill in.

# Private IP of THIS VPS — the port is published only on it (proxy reaches it, internet doesn't).
BIND_IP=10.0.0.5
HOST_PORT=8787

# Postgres password (OAuth store). Generate: openssl rand -hex 16
PG_PASSWORD=

# local | staging | prod
WEBCAKE_ENV=prod

# Optional
PEXELS_API_KEY=
MICROLINK_API_KEY=
